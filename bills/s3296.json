ain": "", "vote": null}, {"id": "bs-S3296-6", "chamber": "senate", "ts": "2026-09-14T12:00:00-05:00", "dateonly": true, "text": "Committee on Homeland Security and Governmental Affairs. Reported by Senator Paul without amendment. Without written report.", "refs": [], "source": "Congress.gov", "kind": "stage", "badge": "COMMITTEE", "label": "Committee action", "explain": "", "vote": null}, {"id": "bs-S3296-8", "chamber": "senate", "ts": "2026-08-06T12:00:00-05:00", "dateonly": true, "text": "Committee on Homeland Security and Governmental Affairs. Ordered to be reported without amendment favorably.", "refs": [], "source": "Congress.gov", "kind": "stage", "badge": "COMMITTEE", "label": "Committee action", "explain": "", "vote": null}, {"id": "bs-S3296-9", "chamber": "senate", "ts": "2025-12-02T12:00:00-05:00", "dateonly": true, "text": "Read twice and referred to the Committee on Homeland Security and Governmental Affairs. (Sponsor introductory remarks on measure: CR S8450-8451)", "refs": [], "source": "Congress.gov", "kind": "stage", "badge": "INTRODUCED", "label": "Introduced / sent to committee", "explain": "", "vote": {"result": "", "yeas": 450, "nays": 845}}], "history_loaded": true}
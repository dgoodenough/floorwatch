w.democrats.senate.gov/2026/11/19/wrap-up-for-thursday-november-19-2026", "wrap": true}, {"id": "bs-S580-3", "chamber": "senate", "ts": "2026-11-19T12:00:00-05:00", "dateonly": true, "text": "Passed Senate with an amendment and an amendment to the Title by Unanimous Consent.", "refs": [], "source": "Congress.gov", "kind": "amendment", "badge": "AMENDMENT", "label": "Amendment", "explain": "A vote on a proposed change, not on the bill itself.", "vote": {"result": "Passed"}}, {"id": "bs-S580-5", "chamber": "senate", "ts": "2026-11-19T12:00:00-05:00", "dateonly": true, "text": "Measure laid before Senate by unanimous consent.", "refs": [], "source": "Congress.gov", "kind": "info", "badge": "UPDATE", "label": "Update", "explain": "", "vote": null}, {"id": "bs-S580-6", "chamber": "senate", "ts": "2025-07-28T12:00:00-05:00", "dateonly": true, "text": "Placed on Senate Legislative Calendar under General Orders. Calendar No. 129.", "refs": [], "source": "Congress.gov", "kind": "stage", "badge": "CALENDAR", "label": "Placed on the calendar", "explain": "", "vote": null}, {"id": "bs-S580-7", "chamber": "senate", "ts": "2025-07-28T12:00:00-05:00", "dateonly": true, "text": "Committee on Commerce, Science, and Transportation. Reported by Senator Cruz without amendment. With written report No. 119-48.", "refs": [], "source": "Congress.gov", "kind": "stage", "badge": "COMMITTEE", "label": "Committee action", "explain": "", "vote": null}, {"id": "bs-S580-9", "chamber": "senate", "ts": "2025-04-30T12:00:00-05:00", "dateonly": true, "text": "Committee on Commerce, Science, and Transportation. Ordered to be reported without amendment favorably.", "refs": [], "source": "Congress.gov", "kind": "stage", "badge": "COMMITTEE", "label": "Committee action", "explain": "", "vote": null}, {"id": "bs-S580-10", "chamber": "senate", "ts": "2025-02-13T12:00:00-05:00", "dateonly": true, "text": "Read twice and referred to the Committee on Commerce, Science, and Transportation.", "refs": [], "sourc
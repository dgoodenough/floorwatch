				<div class="elementor-element elementor-element-d880a73 elementor-widget elementor-widget-heading" data-id="d880a73" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
				<div class="elementor-widget-container">
					<h2 class="elementor-heading-title elementor-size-default"><a href="https://www.senate.gov/committees/hearings_meetings.htm#listOfCommittees_wrapper" target="_blank" rel="nofollow">Senate Hearings &amp; Meetings</a></h2>				</div>
